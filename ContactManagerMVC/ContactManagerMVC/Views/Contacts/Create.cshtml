@model ContactManagerMVC.Models.Contact

@{
	ViewData["Title"] = "New Contact";
}

<h1 class="text-center">New Contact</h1>
<hr />
<form asp-action="Create" method="POST">
	<div asp-validation-summary="ModelOnly" class="text-danger"></div>
	<div class="mb-3">
		<label asp-for="Name" class="form-label"></label>
		<input asp-for="Name" class="form-control" placeholder="Enter the name" />
		<span asp-validation-for="Name" class="text-danger"></span>
	</div>
	<div class="mb-3">
		<label asp-for="Email" class="form-label"></label>
		<input asp-for="Email" class="form-control" placeholder="Enter the email" />
		<span asp-validation-for="Email" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Phone" class="form-label"></label>
		<input asp-for="Phone" class="form-control" placeholder="Enter the phone number" />
		<span asp-validation-for="Phone" class="text-danger"></span>
	</div>

	<div class="mb-3">
		<label asp-for="Address" class="form-label"></label>
		<input asp-for="Address" class="form-control" placeholder="Enter the address" />
		<span asp-validation-for="Address" class="text-danger"></span>
	</div>

	<button type="submit" class="btn btn-primary">Save</button>
	<a asp-action="Index" class="btn btn-secondary">Back</a>
</form>