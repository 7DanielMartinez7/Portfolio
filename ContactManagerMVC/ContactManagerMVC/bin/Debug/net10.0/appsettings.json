{
    "ConnectionStrings": {
    },
    /*
    Server = Indicar que usamos MSSQLocalDB
    Database = Indica el nombre de la base de datos que estamos utilizando
    Trusted_Connection = Uso de autenticación de windows
    MultipleActiveResultSets = Permite multiples consultas activas
    */
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ContactManagerMVC;Trusted_Connection=True;",
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*"
}
